# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL Connection
# WARNING: Change all passwords before deployment. Never commit actual secrets.
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/amas
# PostgreSQL Password (optional if using DATABASE_URL with password)
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================

# Redis Connection
REDIS_URL=redis://:amas_redis_password@redis:6379/0
REDIS_CACHE_TTL=3600

# ============================================================================
# GRAPH DATABASE CONFIGURATION
# ============================================================================

# Neo4j Connection
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_secure_neo4j_password_here

# ============================================================================
# SECURITY
# ============================================================================

# Secret Key for JWT and CSRF
SECRET_KEY=your-super-secret-key-change-in-production

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:80,http://yourdomain.com,http://yourdomain.com:ui
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Environment
ENVIRONMENT=development
# Options: development, staging, production

# Logging
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_FILE=/app/logs/app.log
LOG_FORMAT=json

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# API URL for Frontend
VITE_API_URL=http://localhost:8000/api/v1
# Production: https://yourdomain.com/api/v1

# Frontend Port
FRONTEND_PORT=3000

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

# Backend Port
BACKEND_PORT=8000

# API Documentation
API_DOCS_ENABLED=true
API_DOCS_URL=/docs
API_REDOC_URL=/redoc

# ============================================================================
# AI PROVIDER CONFIGURATION
# ============================================================================

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4096

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus

# Ollama (Local). Router accepts optional /v1 suffix; tags must match `ollama list`.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Local-only mode: use Ollama only (no cloud providers). Requires running Ollama + at least one model.
AMAS_LOCAL_ONLY=false
# If false/no/off, same as local-only (alias).
AMAS_ALLOW_CLOUD=true

# Per-agent Ollama model (overrides OLLAMA_MODEL for that agent_type), e.g. AMAS_OLLAMA_MODEL_CODE=deepseek-r1:latest
# Optional YAML map (copy config/local_agent_models.yaml.example):
# AMAS_LOCAL_AGENT_MODELS_YAML=config/local_agent_models.yaml

# Workspace tools (read/grep/list) default to process working directory unless set:
AMAS_WORKSPACE_ROOT=

# Disable provider-native tool_calls (e.g. weak Ollama models). Parsed/text path only.
AMAS_DISABLE_NATIVE_TOOLS=false
# Comma-separated substrings; if OLLAMA_MODEL or per-agent override contains one, tools are not sent.
# Example: AMAS_OLLAMA_DISABLE_TOOLS_TAGS=gemma,llama3.2,deepseek-r1
AMAS_OLLAMA_DISABLE_TOOLS_TAGS=

# GitHub read integration (optional; improves github_api tool + IntegrationAgent helpers)
GITHUB_TOKEN=

# Tier-3 platform integrations (optional; IntegrationAgent + process_integration_event)
SLACK_BOT_TOKEN=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Named n8n flows (optional). See config/n8n_webhooks.example.yaml or N8N_WEBHOOKS_CONFIG.
N8N_WEBHOOK_NOTIFY_URL=
N8N_WEBHOOK_ENRICH_URL=
N8N_WEBHOOK_REPORT_URL=
N8N_WEBHOOKS_CONFIG=

# Qdrant (optional; docker-compose.local-ai.yml sets http://qdrant:6333 for in-stack use)
QDRANT_URL=
QDRANT_API_KEY=

# MCP HTTP bridge (optional). Point to a sidecar that exposes tool invoke over HTTP, or skills_mcp_server HTTP shim.
AMAS_MCP_HTTP_BASE_URL=
AMAS_MCP_HTTP_BEARER_TOKEN=

# Operator GET /api/v1/probes (BE-10): unset = honest "not configured" (no localhost defaults).
# Use reachable health URLs when n8n / MCP sidecars exist (same Docker network: http://n8n:5678/healthz).
AMAS_N8N_HEALTH_URL=
AMAS_MCP_HEALTH_URL=

# Small Ollama planner tag for routing JSON (optional). Example: erukude/multiagent-orchestrator
AMAS_PLANNER_OLLAMA_MODEL=

NOTION_TOKEN=
NOTION_VERSION=2022-06-28
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
SALESFORCE_INSTANCE_URL=https://yourinstance.salesforce.com
SALESFORCE_ACCESS_TOKEN=
SALESFORCE_API_VERSION=v59.0

# Verified HTTP webhooks (FastAPI) — HMAC/signature checked before IntegrationAgent
GITHUB_WEBHOOK_SECRET=
SLACK_SIGNING_SECRET=

# Expose AI router debug (provider health) on GET /api/v1/system/ai-providers when not dev/staging
AMAS_EXPOSE_AI_DEBUG=false

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=true
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=amas_grafana_password

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# SMTP for feedback emails
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=AMAS System

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Landing Page
FEATURE_LANDING_PAGE=true
FEATURE_DARK_MODE=true
FEATURE_FEEDBACK_FORM=true
FEATURE_DEMO_SANDBOX=true

# Core Features
FEATURE_TASK_EXECUTION=true
FEATURE_AGENT_MANAGEMENT=true
FEATURE_WORKFLOW_BUILDER=true
FEATURE_INTEGRATIONS=true
FEATURE_ANALYTICS=true
FEATURE_PREDICTIONS=true

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================

# Docker Network
DOCKER_NETWORK=amas-network
DOCKER_SUBNET=172.20.0.0/16

# ============================================================================
# DEVELOPMENT CONFIGURATION
# ============================================================================

# Debug Mode
DEBUG=false

# Reload on code changes
RELOAD=true

# Database migrations
ALEMBIC_ENABLED=true

# ============================================================================
# PRODUCTION CONFIGURATION
# ============================================================================

# HTTPS/SSL
HTTPS_ENABLED=true
SSL_CERT_FILE=/app/config/ssl/cert.pem
SSL_KEY_FILE=/app/config/ssl/key.pem

# Domain
PRIMARY_DOMAIN=yourdomain.com
FRONTEND_DOMAIN=yourdomain.com/ui

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================================
# BACKUP & DISASTER RECOVERY
# ============================================================================

# Database Backups
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # 2 AM daily
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/app/backups
